{
  "name": "culinary-tool-fab",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "eslint --fix .; prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,html}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/hugeicons": "^1.2.36",
    "@iconify/tailwind4": "^1.2.3",
    "@sveltejs/adapter-auto": "^8.0.1",
    "@sveltejs/enhanced-img": "^1.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/hyphen": "^1.14.0",
    "@types/node": "^24",
    "daisyui": "^5.8.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@xyflow/svelte": "^2.0.2",
    "ai": "^7.0.177",
    "hyphen": "^1.14.1",
    "valibot": "^1.5.0"
  }
}
